{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "autoupdate": false,
  "subagent_depth": 1,
  "permission": {
    "read": "allow",
    "list": "allow",
    "glob": "allow",
    "grep": "allow",
    "lsp": "allow",
    "skill": "allow",
    "todowrite": "allow",
    "external_directory": "allow",
    "task": "allow",
    "question": "deny",
    "webfetch": "allow",
    "websearch": "allow",
    "doom_loop": "deny",
    "edit": {
      "*": "allow",
      "{{LIBRARY}}/courses/**": "deny",
      "{{LIBRARY}}/.library-move/**": "deny",
      "{{LIBRARY}}/.oculus/canvas-session/**": "deny",
      "{{LIBRARY}}/.oculus/bin/**": "deny",
      "{{LIBRARY}}/.oculus/oculus.db*": "deny",
      "{{LIBRARY}}/.oculus/*.cookie": "deny",
      "{{LIBRARY}}/.oculus/*.token": "deny",
      "{{LIBRARY}}/.oculus/*.json": "deny",
      "{{LIBRARY}}/.oculus/*.log": "deny",
      "{{LIBRARY}}/.oculus/vault.bin*": "deny",
      "{{LIBRARY}}/.oculus/.vault.bin.*": "deny",
      "{{LIBRARY}}/courses/*/*": "allow",
      "{{LIBRARY}}/courses/*/Course": "deny",
      "{{LIBRARY}}/courses/*/Course/*": "deny",
      "{{LIBRARY}}/courses/*/.oculus": "deny",
      "{{LIBRARY}}/courses/*/.oculus/*": "deny",
      "{{LIBRARY}}/.oculus/studio/**": "allow",
      "opencode.json": "deny",
      "skills/**": "deny",
      ".claude/skills/**": "deny",
      ".agents/skills/**": "deny",
      ".opencode/**": "deny"
    },
    "bash": {
      "*": "deny",
      "ls": "allow",
      "ls *": "allow",
      "oculus": "allow",
      "oculus *": "allow"
    }
  },
  "skills": {
    "paths": ["skills"]
  },
  "agent": {
    "oculus": {
      "mode": "primary",
      "description": "The Oculus coursework agent",
      "prompt": "{{PROMPT}}"
    },
    "oculus-revision-marker": {
      "mode": "primary", "hidden": true,
      "description": "Marks one submitted revision answer",
      "prompt": "{{REVISION_PROMPT}}",
      "permission": { "*": "deny" }
    },
    "oculus-namer": {
      "mode": "primary",
      "hidden": true,
      "description": "Names one conversation",
      "prompt": "{{NAMING_PROMPT}}",
      "permission": { "*": "deny" }
    },
    "oculus-writer": {
      "mode": "primary",
      "hidden": true,
      "description": "Completes the sentence at a note's caret",
      "prompt": "{{WRITER_PROMPT}}",
      "permission": { "*": "deny" }
    },
    "oculus-lecture-end": {
      "mode": "primary",
      "hidden": true,
      "description": "Finds where a lecture recording's content ends",
      "prompt": "{{LECTURE_END_PROMPT}}",
      "permission": { "*": "deny" }
    },
    "oculus-widget": {
      "mode": "primary",
      "hidden": true,
      "description": "Answers a chat widget's request with JSON",
      "prompt": "{{WIDGET_PROMPT}}",
      "permission": { "*": "deny" }
    }
  }
}
